# --- Database (PostgreSQL 16) -------------------------------------------
POSTGRES_DB=simple_stock_flow
POSTGRES_USER=simple_stock_flow
POSTGRES_PASSWORD=postgres_secret_123

# --- Token signing (JWT) ------------------------------------------------
# Clave secreta para firmar tokens JWT (mínimo 32 caracteres)
JWT_SIGNING_KEY=simple_stock_flow_super_secret_jwt_key_3413974_adso

# --- First administrator ------------------------------------------------
# Credenciales del administrador inicial (creado en el arranque de la API)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin123*

# --- Published port -----------------------------------------------------
# Puerto publicado del portal hacia el anfitrión
PORTAL_PORT=8080
SERVICE_PORT=5000
POSTGRES_PORT=5432
